// ============================================================
// Q15. Mini Generic Student Management Program
// ============================================================

class StudentQ15<T, U, V> {

    private T studentId;
    private U studentName;
    private V marks;

    StudentQ15(T studentId, U studentName, V marks) {
        this.studentId = studentId;
        this.studentName = studentName;
        this.marks = marks;
    }

    T getStudentId() {
        return studentId;
    }

    U getStudentName() {
        return studentName;
    }

    V getMarks() {
        return marks;
    }

    void display() {
        System.out.println(
            "ID: " + studentId +
            ", Name: " + studentName +
            ", Marks: " + marks
        );
    }
}

class Q15 {

    public static void main(String[] args) {

        // ArrayList using generic Student class
        ArrayList<StudentQ15<Integer, String, Double>> students =
                new ArrayList<>();


        // --------------------------------------------------------
        // Add five students
        // --------------------------------------------------------

        students.add(
            new StudentQ15<>(
                101, "Aman", 85.5
            )
        );

        students.add(
            new StudentQ15<>(
                102, "Rahul", 78.0
            )
        );

        students.add(
            new StudentQ15<>(
                103, "Priya", 92.5
            )
        );

        students.add(
            new StudentQ15<>(
                104, "Neha", 88.0
            )
        );

        students.add(
            new StudentQ15<>(
                105, "Karan", 74.5
            )
        );


        // --------------------------------------------------------
        // Display all students
        // --------------------------------------------------------

        System.out.println("===== ALL STUDENTS =====");

        for (StudentQ15<Integer, String, Double> student : students) {
            student.display();
        }


        // --------------------------------------------------------
        // get()
        // --------------------------------------------------------

        System.out.println("\n===== GET STUDENT =====");

        StudentQ15<Integer, String, Double> firstStudent =
                students.get(0);

        firstStudent.display();


        // --------------------------------------------------------
        // Search for a student
        // --------------------------------------------------------

        int searchId = 103;
        boolean found = false;

        System.out.println("\n===== SEARCH =====");

        for (StudentQ15<Integer, String, Double> student : students) {

            if (student.getStudentId().equals(searchId)) {

                System.out.println(
                    "Student Found:"
                );

                student.display();

                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println(
                "Student not found."
            );
        }


        // --------------------------------------------------------
        // contains() demonstration
        // --------------------------------------------------------

        System.out.println("\n===== CONTAINS =====");

        boolean containsStudent = students.contains(firstStudent);

        System.out.println(
            "First student exists: " + containsStudent
        );


        // --------------------------------------------------------
        // size()
        // --------------------------------------------------------

        System.out.println("\n===== TOTAL STUDENTS =====");

        System.out.println(
            "Total Students: " + students.size()
        );


        // --------------------------------------------------------
        // Type Safety
        // --------------------------------------------------------

        System.out.println("\n===== TYPE SAFETY =====");

        StudentQ15<Integer, String, Double> safeStudent =
                new StudentQ15<>(
                    106,
                    "Divya",
                    95.5
                );

        safeStudent.display();

        /*
         * Type Safety:
         *
         * Student ID must be Integer.
         * Student Name must be String.
         * Marks must be Double.
         *
         * The following would give a compile-time error:
         *
         * StudentQ15<Integer, String, Double> wrong =
         *     new StudentQ15<>(
         *         "ABC",       // Wrong: String instead of Integer
         *         123,        // Wrong: Integer instead of String
         *         "90"        // Wrong: String instead of Double
         *     );
         */
    }
}
