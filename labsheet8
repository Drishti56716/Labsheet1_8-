// ============================================================
// Q1. Generic Box
// ============================================================

class Box<T> {
    private T value;

    Box(T value) {
        this.value = value;
    }

    T getValue() {
        return value;
    }
}

class Q1 {
    public static void main(String[] args) {

        Box<Integer> b1 = new Box<>(100);
        Box<String> b2 = new Box<>("Hello");
        Box<Double> b3 = new Box<>(25.5);

        System.out.println("Integer: " + b1.getValue());
        System.out.println("String: " + b2.getValue());
        System.out.println("Double: " + b3.getValue());
    }
}


