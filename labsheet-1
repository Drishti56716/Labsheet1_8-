import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Q1. Display name, age, and college name
        String name = "Divya";
        int age = 20;
        String college = "Chandigarh University";

        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("College: " + college);


        // Q2. Arithmetic operations on two integers
        int a = 20, b = 10;

        System.out.println("\nQ2 Arithmetic Operations:");
        System.out.println("Addition = " + (a + b));
        System.out.println("Subtraction = " + (a - b));
        System.out.println("Multiplication = " + (a * b));
        System.out.println("Division = " + (a / b));
        System.out.println("Modulus = " + (a % b));


        // Q3. Check even or odd
        int num = 15;

        System.out.println("\nQ3 Even or Odd:");
        if (num % 2 == 0)
            System.out.println("Even");
        else
            System.out.println("Odd");


        // Q4. Relational operators
        int x = 20, y = 15;

        System.out.println("\nQ4 Relational Operators:");
        System.out.println("x == y: " + (x == y));
        System.out.println("x != y: " + (x != y));
        System.out.println("x > y: " + (x > y));
        System.out.println("x < y: " + (x < y));
        System.out.println("x >= y: " + (x >= y));
        System.out.println("x <= y: " + (x <= y));


        // Q5. Explicit type casting float to int
        float f = 25.75f;
        int converted = (int) f;

        System.out.println("\nQ5 Type Casting:");
        System.out.println("Original value = " + f);
        System.out.println("Converted value = " + converted);


        // Q6. Character ASCII value
        char ch = 'A';

        System.out.println("\nQ6 ASCII Value:");
        System.out.println("Character = " + ch);
        System.out.println("ASCII value = " + (int) ch);


        // Q7. Check divisibility by both 3 and 5
        int n = 30;

        System.out.println("\nQ7 Divisible by 3 and 5:");
        if (n % 3 == 0 && n % 5 == 0)
            System.out.println("Number is divisible by both 3 and 5");
        else
            System.out.println("Number is not divisible by both 3 and 5");


        // Q8. Check vowel or consonant
        char letter = 'e';

        System.out.println("\nQ8 Vowel or Consonant:");
        if (letter == 'a' || letter == 'e' || letter == 'i' ||
            letter == 'o' || letter == 'u' ||
            letter == 'A' || letter == 'E' || letter == 'I' ||
            letter == 'O' || letter == 'U')
            System.out.println("Vowel");
        else
            System.out.println("Consonant");


        // Q9. Total, percentage and pass/fail
        int m1 = 70, m2 = 65, m3 = 80;
        int total = m1 + m2 + m3;
        double percentage = total / 3.0;

        System.out.println("\nQ9 Marks:");
        System.out.println("Total = " + total);
        System.out.println("Percentage = " + percentage);

        if (m1 >= 40 && m2 >= 40 && m3 >= 40)
            System.out.println("Pass");
        else
            System.out.println("Fail");


        // Q10. Greatest of two numbers
        int p = 50, q = 40;

        System.out.println("\nQ10 Greatest of Two:");
        if (p > q)
            System.out.println(p + " is greatest");
        else
            System.out.println(q + " is greatest");


        // Q11. Largest of three numbers using nested if-else
        int n1 = 30, n2 = 70, n3 = 50;
        int largest;

        System.out.println("\nQ11 Largest of Three:");
        if (n1 > n2) {
            if (n1 > n3)
                largest = n1;
            else
                largest = n3;
        } else {
            if (n2 > n3)
                largest = n2;
            else
                largest = n3;
        }

        System.out.println("Largest = " + largest);


        // Q12. Check leap year
        int year = 2024;

        System.out.println("\nQ12 Leap Year:");
        if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0))
            System.out.println("Leap Year");
        else
            System.out.println("Not a Leap Year");


        // Q13. Positive, negative or zero
        int value = -10;

        System.out.println("\nQ13 Positive, Negative or Zero:");
        if (value > 0)
            System.out.println("Positive");
        else if (value < 0)
            System.out.println("Negative");
        else
            System.out.println("Zero");


        // Q14. Character classification
        char c = 'A';

        System.out.println("\nQ14 Character Classification:");
        if (c >= '0' && c <= '9')
            System.out.println("Digit");
        else if (c >= 'A' && c <= 'Z')
            System.out.println("Uppercase Letter");
        else if (c >= 'a' && c <= 'z')
            System.out.println("Lowercase Letter");
        else
            System.out.println("Special Character");


        // Q15. Check 3-digit Armstrong number
        int arm = 153;
        int original = arm;
        int sum = 0;

        while (arm > 0) {
            int digit = arm % 10;
            sum = sum + (digit * digit * digit);
            arm = arm / 10;
        }

        System.out.println("\nQ15 Armstrong Number:");
        if (sum == original)
            System.out.println(original + " is an Armstrong number");
        else
            System.out.println(original + " is not an Armstrong number");


        // Q16. Calculate tax according to income slabs
        double income = 600000;
        double tax;

        System.out.println("\nQ16 Income Tax:");

        if (income <= 250000)
            tax = 0;
        else if (income <= 500000)
            tax = income * 0.05;
        else if (income <= 1000000)
            tax = income * 0.20;
        else
            tax = income * 0.30;

        System.out.println("Income = " + income);
        System.out.println("Tax = " + tax);


        // Q17. Check palindrome number
        int palindrome = 121;
        int temp = palindrome;
        int reverse = 0;

        while (temp > 0) {
            int digit = temp % 10;
            reverse = reverse * 10 + digit;
            temp = temp / 10;
        }

        System.out.println("\nQ17 Palindrome:");
        if (palindrome == reverse)
            System.out.println("Palindrome");
        else
            System.out.println("Not a Palindrome");


        // Q18. Check prime number
        int prime = 17;
        boolean isPrime = true;

        if (prime <= 1)
            isPrime = false;
        else {
            for (int i = 2; i <= prime / 2; i++) {
                if (prime % i == 0) {
                    isPrime = false;
                    break;
                }
            }
        }

        System.out.println("\nQ18 Prime Number:");
        if (isPrime)
            System.out.println("Prime");
        else
            System.out.println("Not Prime");


        // Q19. Operator and perform operation
        int num1 = 20, num2 = 5;
        char operator = '*';
        double result;

        System.out.println("\nQ19 Operator:");

        if (operator == '+')
            result = num1 + num2;
        else if (operator == '-')
            result = num1 - num2;
        else if (operator == '*')
            result = num1 * num2;
        else if (operator == '/')
            result = (double) num1 / num2;
        else {
            System.out.println("Invalid Operator");
            result = 0;
        }

        if (operator == '+' || operator == '-' ||
            operator == '*' || operator == '/')
            System.out.println("Result = " + result);


        // Q20. Marriage eligibility
        int personAge = 22;
        char gender = 'M';

        System.out.println("\nQ20 Marriage Eligibility:");

        if (gender == 'M' || gender == 'm') {
            if (personAge >= 21)
                System.out.println("Eligible for marriage");
            else
                System.out.println("Not eligible for marriage");
        } else if (gender == 'F' || gender == 'f') {
            if (personAge >= 18)
                System.out.println("Eligible for marriage");
            else
                System.out.println("Not eligible for marriage");
        } else {
            System.out.println("Invalid gender");
        }


        // Q21. Check valid triangle using angles
        int angle1 = 60, angle2 = 60, angle3 = 60;

        System.out.println("\nQ21 Valid Triangle:");
        if (angle1 > 0 && angle2 > 0 && angle3 > 0 &&
            angle1 + angle2 + angle3 == 180)
            System.out.println("Valid Triangle");
        else
            System.out.println("Invalid Triangle");


        // Q22. Check rectangle is square
        int length = 10;
        int breadth = 10;

        System.out.println("\nQ22 Square or Rectangle:");
        if (length == breadth)
            System.out.println("It is a Square");
        else
            System.out.println("It is a Rectangle");


        // Q23. Celsius to Fahrenheit
        double celsius = 25;
        double fahrenheit = (celsius * 9 / 5) + 32;

        System.out.println("\nQ23 Temperature Conversion:");
        System.out.println("Celsius = " + celsius);
        System.out.println("Fahrenheit = " + fahrenheit);


        // Q24. Check perfect number
        int perfect = 28;
        int divisorSum = 0;

        for (int i = 1; i < perfect; i++) {
            if (perfect % i == 0)
                divisorSum += i;
        }

        System.out.println("\nQ24 Perfect Number:");
        if (divisorSum == perfect)
            System.out.println("Perfect Number");
        else
            System.out.println("Not a Perfect Number");


        // Q25. Logical operation using logical operator
        boolean bool1 = true;
        boolean bool2 = false;
        char logicalOperator = '&';

        System.out.println("\nQ25 Logical Operation:");

        if (logicalOperator == '&')
            System.out.println("Result = " + (bool1 && bool2));
        else if (logicalOperator == '|')
            System.out.println("Result = " + (bool1 || bool2));
        else if (logicalOperator == '!')
            System.out.println("Result = " + (!bool1));
        else
            System.out.println("Invalid Logical Operator");


        // Q26. Check first and last digit of five-digit number
        int fiveDigit = 12341;
        int firstDigit = fiveDigit / 10000;
        int lastDigit = fiveDigit % 10;

        System.out.println("\nQ26 First and Last Digit:");
        if (firstDigit == lastDigit)
            System.out.println("First and last digits are same");
        else
            System.out.println("First and last digits are different");


        // Q27. Profit or Loss
        double costPrice = 1000;
        double sellingPrice = 1200;

        System.out.println("\nQ27 Profit or Loss:");

        if (sellingPrice > costPrice) {
            System.out.println("Profit = " + (sellingPrice - costPrice));
        } else if (costPrice > sellingPrice) {
            System.out.println("Loss = " + (costPrice - sellingPrice));
        } else {
            System.out.println("No Profit No Loss");
        }


        // Q28. Count number of digits
        int digitNumber = 123456;
        int count = 0;
        int tempNumber = digitNumber;

        if (tempNumber == 0) {
            count = 1;
        } else {
            if (tempNumber < 0)
                tempNumber = -tempNumber;

            while (tempNumber > 0) {
                count++;
                tempNumber = tempNumber / 10;
            }
        }

        System.out.println("\nQ28 Number of Digits:");
        System.out.println("Number of digits = " + count);


        // Q29. Height classification
        double height = 165;

        System.out.println("\nQ29 Height Classification:");

        if (height < 150)
            System.out.println("Short");
        else if (height <= 170)
            System.out.println("Average");
        else
            System.out.println("Tall");


        // Q30. Simple Calculator
        double number1 = 20;
        double number2 = 4;
        char op = '+';

        System.out.println("\nQ30 Simple Calculator:");

        if (op == '+')
            System.out.println("Result = " + (number1 + number2));
        else if (op == '-')
            System.out.println("Result = " + (number1 - number2));
        else if (op == '*')
            System.out.println("Result = " + (number1 * number2));
        else if (op == '/') {
            if (number2 != 0)
                System.out.println("Result = " + (number1 / number2));
            else
                System.out.println("Cannot divide by zero");
        } else
            System.out.println("Invalid Operator");


        sc.close();
    }
}
