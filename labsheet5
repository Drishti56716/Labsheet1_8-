// ============================================================
// Q15. Shape Area Overriding
// ============================================================

class ShapeQ15 {
    double calculateArea() {
        return 0;
    }
}

class CircleQ15 extends ShapeQ15 {
    double radius;

    CircleQ15(double radius) {
        this.radius = radius;
    }

    @Override
    double calculateArea() {
        return Math.PI * radius * radius;
    }
}

class RectangleQ15 extends ShapeQ15 {
    double length;
    double breadth;

    RectangleQ15(double length, double breadth) {
        this.length = length;
        this.breadth = breadth;
    }

    @Override
    double calculateArea() {
        return length * breadth;
    }
}


