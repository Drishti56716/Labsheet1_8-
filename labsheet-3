    // Q22. Count frequency of each element
    static void q22() {

        System.out.print("\nQ22. Enter size of array: ");
        int n = sc.nextInt();

        int[] arr = new int[n];
        boolean[] visited = new boolean[n];

        System.out.println("Enter elements:");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        System.out.println("Frequency:");

        for (int i = 0; i < n; i++) {

            if (visited[i]) {
                continue;
            }

            int count = 1;

            for (int j = i + 1; j < n; j++) {

                if (arr[i] == arr[j]) {
                    count++;
                    visited[j] = true;
                }
            }

            System.out.println(
                    arr[i] + " appears " + count + " time(s)"
            );
        }
    }

    // Q23. Second largest element
    static void q23() {

        System.out.print("\nQ23. Enter size of array: ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        System.out.println("Enter elements:");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int largest = Integer.MIN_VALUE;
        int secondLargest = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {

            if (arr[i] > largest) {

                secondLargest = largest;
                largest = arr[i];

            } else if (arr[i] > secondLargest &&
                       arr[i] != largest) {

                secondLargest = arr[i];
            }
        }

        if (secondLargest == Integer.MIN_VALUE) {
            System.out.println(
                    "Second largest element does not exist."
            );
        } else {
            System.out.println(
                    "Second largest = " + secondLargest
            );
        }
    }

    // Q24. Remove duplicate elements
    static void q24() {

        System.out.print("\nQ24. Enter size of array: ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        System.out.println("Enter elements:");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int[] unique = new int[n];
        int count = 0;

        for (int i = 0; i < n; i++) {

            boolean exists = false;

            for (int j = 0; j < count; j++) {

                if (arr[i] == unique[j]) {
                    exists = true;
                    break;
                }
            }

            if (!exists) {
                unique[count] = arr[i];
                count++;
            }
        }

        System.out.println("After removing duplicates:");

        for (int i = 0; i < count; i++) {
            System.out.print(unique[i] + " ");
        }

        System.out.println();
    }

    // Q25. Main and secondary diagonal sum
    static void q25() {

        System.out.print("\nQ25. Enter size of square matrix: ");
        int n = sc.nextInt();

        int[][] a = new int[n][n];

        System.out.println("Enter matrix:");

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                a[i][j] = sc.nextInt();
            }
        }

        int mainSum = 0;
        int secondarySum = 0;

        for (int i = 0; i < n; i++) {

            mainSum += a[i][i];

            secondarySum += a[i][n - 1 - i];
        }

        System.out.println("Main diagonal sum = " + mainSum);
        System.out.println(
                "Secondary diagonal sum = " + secondarySum
        );
    }

