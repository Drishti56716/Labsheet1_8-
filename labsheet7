// ============================================================
// Q1. Create a thread by extending Thread class
// ============================================================

class Q1Thread extends Thread {

    @Override
    public void run() {
        for (int i = 1; i <= 5; i++) {
            System.out.println("Divya");

            try {
                Thread.sleep(200);
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }
}

class Q1 {
    public static void main(String[] args) {

        Q1Thread t = new Q1Thread();
        t.start();
    }
}


