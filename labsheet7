        Q5Thread writer = new Q5Thread("Writer");
        Q5Thread logger = new Q5Thread("Logger");

        reader.start();
        writer.start();
        logger.start();
    }
}


// ============================================================
// Q6. Demonstrate isAlive()
// ============================================================

class Q6Thread extends Thread {

    @Override
    public void run() {

        System.out.println("Thread is running...");

        try {
            Thread.sleep(1000);
        } catch (InterruptedException e) {
            System.out.println(e);
        }

        System.out.println("Thread finished.");
    }
}

class Q6 {
    public static void main(String[] args) {

        Q6Thread t = new Q6Thread();

        System.out.println("Before start: " + t.isAlive());

        t.start();

        System.out.println("While running: " + t.isAlive());

        try {
            t.join();
        } catch (InterruptedException e) {
            System.out.println(e);
        }

        System.out.println("After finish: " + t.isAlive());
    }
}


// ============================================================
// Q7. Use join() for long-running task
