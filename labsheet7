// ============================================================
// Q10. Bank Account Race Condition
// ============================================================

class BankAccountQ10 {

    int balance = 10000;

    void withdraw(int amount) {

        if (balance >= amount) {

            try {
                Thread.sleep(1);
            } catch (InterruptedException e) {
                System.out.println(e);
            }

            balance -= amount;
        }
    }
}

class Q10Thread extends Thread {

    BankAccountQ10 account;

    Q10Thread(BankAccountQ10 account) {
        this.account = account;
    }

    @Override
    public void run() {

        for (int i = 1; i <= 1000; i++) {
            account.withdraw(10);
        }
    }
}

class Q10 {
    public static void main(String[] args) {

        BankAccountQ10 account = new BankAccountQ10();

        Q10Thread t1 = new Q10Thread(account);
        Q10Thread t2 = new Q10Thread(account);

        t1.start();
        t2.start();

        try {
            t1.join();
            t2.join();
        } catch (InterruptedException e) {
            System.out.println(e);
        }

        System.out.println(
            "Final Balance = " + account.balance
        );

        System.out.println(
            "Expected Balance = -10000 (race condition may occur)"
        );
    }
}


