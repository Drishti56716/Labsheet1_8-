// Q11. Calculator Class
class Calculator {

    static int operationsCount = 0;

    int add(int a, int b) {
        // Local variables
        int num1 = a;
        int num2 = b;
        int result = num1 + num2;

        operationsCount++;
        return result;
    }

    int subtract(int a, int b) {
        // Local variables
        int num1 = a;
        int num2 = b;
        int result = num1 - num2;

        operationsCount++;
        return result;
    }

    int multiply(int a, int b) {
        // Local variables
        int num1 = a;
        int num2 = b;
        int result = num1 * num2;

        operationsCount++;
        return result;
    }

    double divide(int a, int b) {
        // Local variables
        int num1 = a;
        int num2 = b;
        double result = (double) num1 / num2;

        operationsCount++;
        return result;
    }
}


