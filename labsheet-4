// Q16. Triangle Class
class Triangle {
    double a;
    double b;
    double c;

    static String type = "Scalene/Isosceles/Equilateral";

    void setSides(double x, double y, double z) {
        a = x;
        b = y;
        c = z;
    }

    void checkValidity() {
        // Local variables
        double sideA = a;
        double sideB = b;
        double sideC = c;

        boolean valid = (sideA + sideB > sideC)
                && (sideB + sideC > sideA)
                && (sideA + sideC > sideB);

        System.out.println("Sides: " + sideA + ", " + sideB + ", " + sideC);

        if (valid) {
            System.out.println("Triangle: Valid");

            if (sideA == sideB && sideB == sideC) {
                System.out.println("Type: Equilateral");
            } else if (sideA == sideB || sideB == sideC || sideA == sideC) {
                System.out.println("Type: Isosceles");
            } else {
                System.out.println("Type: Scalene");
            }
        } else {
            System.out.println("Triangle: Invalid");
        }
    }
}


