// Q30. Library Class
class Library {

    int booksAvailable;

    static String libraryName = "Central Library";

    void setBooks(int books) {
        booksAvailable = books;
    }

    void issueBook(int numberOfBooks) {
        // Local variables
        int availableBooks = booksAvailable;
        int issueCount = numberOfBooks;

        if (issueCount <= availableBooks) {
            availableBooks = availableBooks - issueCount;
            booksAvailable = availableBooks;

            System.out.println("Books Issued: " + issueCount);
            System.out.println("Books Available: " + availableBooks);
        } else {
            System.out.println("Issue Failed.");
            System.out.println("Not enough books available.");
        }
    }

    void returnBook(int numberOfBooks) {
        // Local variables
        int availableBooks = booksAvailable;
        int returnCount = numberOfBooks;

        availableBooks = availableBooks + returnCount;
        booksAvailable = availableBooks;

        System.out.println("Books Returned: " + returnCount);
        System.out.println("Books Available: " + availableBooks);
    }

    void displayDetails() {
        // Local variable
        int availableBooks = booksAvailable;

        System.out.println("Library: " + libraryName);
        System.out.println("Books Available: " + availableBooks);
    }
}


