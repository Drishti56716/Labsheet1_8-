// Q21. Palindrome Class
class Palindrome {

    static int countChecks = 0;

    void checkPalindrome(int number) {
        // Local variables
        int original = number;
        int temp = number;
        int reverse = 0;

        while (temp != 0) {
            int digit = temp % 10;
            reverse = reverse * 10 + digit;
            temp = temp / 10;
        }

        countChecks++;

        System.out.println("Number: " + original);

        if (original == reverse) {
            System.out.println("Palindrome: Yes");
        } else {
            System.out.println("Palindrome: No");
        }
    }
}


// Q22. Armstrong Class
class Armstrong {

    static int totalChecks = 0;

    void checkArmstrong(int number) {
        // Local variables
        int original = number;
        int temp = number;
        int digits = 0;
        int sum = 0;

        while (temp != 0) {
            digits++;
            temp = temp / 10;
        }

        temp = number;

        while (temp != 0) {
            int digit = temp % 10;
            sum += Math.pow(digit, digits);
            temp = temp / 10;
        }

        totalChecks++;

        System.out.println("Number: " + original);

        if (sum == original) {
            System.out.println("Armstrong: Yes");
        } else {
            System.out.println("Armstrong: No");
        }
    }
}


// Q23. PrimeChecker Class
class PrimeChecker {

    static int totalPrimeChecks = 0;

    void checkPrime(int number) {
        // Local variables
        int num = number;
        boolean prime = true;

        if (num <= 1) {
            prime = false;
        } else {
            for (int i = 2; i <= Math.sqrt(num); i++) {
                if (num % i == 0) {
                    prime = false;
                    break;
                }
            }
        }

        totalPrimeChecks++;

        System.out.println("Number: " + num);

        if (prime) {
            System.out.println("Prime: Yes");
        } else {
            System.out.println("Prime: No");
        }
    }
}


// Q24. Fibonacci Class
class Fibonacci {

    static int seriesCount = 0;

    void displaySeries(int n) {
        // Local variables
        int terms = n;
        int first = 0;
        int second = 1;

        seriesCount++;

        System.out.print("Fibonacci Series: ");

        for (int i = 1; i <= terms; i++) {
            System.out.print(first + " ");

            int next = first + second;
            first = second;
            second = next;
        }

        System.out.println();
    }
}


// Q25. Factorial Class
class Factorial {

    static int totalCalls = 0;

    void calculateFactorial(int number) {
        // Local variables
        int num = number;
        long factorial = 1;

        for (int i = 1; i <= num; i++) {
            factorial = factorial * i;
        }

        totalCalls++;

        System.out.println("Number: " + num);
        System.out.println("Factorial: " + factorial);
    }
}


// Q26. Matrix Class
class Matrix {

    int[][] matrix1 = new int[2][2];
    int[][] matrix2 = new int[2][2];

    static String matrixType = "2x2 Matrix";

    void setMatrices(int[][] m1, int[][] m2) {
        matrix1 = m1;
        matrix2 = m2;
    }

    void addMatrices() {
        // Local variable
        int[][] result = new int[2][2];

        System.out.println("Matrix Addition:");

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                result[i][j] = matrix1[i][j] + matrix2[i][j];
                System.out.print(result[i][j] + " ");
            }
            System.out.println();
        }
    }

    void subtractMatrices() {
        // Local variable
        int[][] result = new int[2][2];

        System.out.println("Matrix Subtraction:");

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                result[i][j] = matrix1[i][j] - matrix2[i][j];
                System.out.print(result[i][j] + " ");
            }
            System.out.println();
        }
    }
}


// Q27. StringReverse Class
class StringReverse {

    static int totalReversals = 0;

    void reverseString(String text) {
        // Local variables
        String original = text;
        String reverse = "";

        for (int i = original.length() - 1; i >= 0; i--) {
            reverse = reverse + original.charAt(i);
        }

        totalReversals++;

        System.out.println("Original String: " + original);
        System.out.println("Reversed String: " + reverse);
    }
}


